---
import BlogPostLayout from 'src/layouts/BlogPostLayout.astro'
import { getCollection, render } from 'astro:content'
import { getImage } from 'astro:assets'

export const prerender = true

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => {
    const [slug, lang] = post.slug.split('/')
    return { params: { lang, slug } }
  })
}

const { lang, slug } = Astro.params

const pages = await getCollection('blog')
const post = pages.find((page) => {
  const [pageSlug, pageLang] = page.slug.split('/')
  return pageSlug === slug && pageLang === lang
})

if (!post) throw new Error(`Post not found: ${lang}/${slug}`)

const { Content, headings } = await render(post)
const { title, seoTitle, shortDescription, author, date, tags, cover } =
  post.data

const ogWidth = Math.min(1200, cover.width)
const ogImage = await getImage({
  src: cover,
  width: ogWidth,
  height: Math.round((ogWidth * 630) / 1200),
  fit: 'cover',
  format: 'jpg',
  quality: 82
})

const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length
const readingTime = Math.max(1, Math.ceil(wordCount / 200))

const langPosts = pages
  .filter((p) => p.slug.endsWith(`/${lang}`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const currentIndex = langPosts.findIndex((p) => p.slug === post.slug)

const toNavPost = (p: (typeof langPosts)[number]) => ({
  slug: p.slug.split('/')[0],
  title: p.data.title,
  tags: p.data.tags
})

const prevPost =
  currentIndex < langPosts.length - 1
    ? toNavPost(langPosts[currentIndex + 1])
    : null
const nextPost =
  currentIndex > 0 ? toNavPost(langPosts[currentIndex - 1]) : null

const morePosts = langPosts
  .filter((_, i) => i !== currentIndex)
  .slice(0, 3)
  .map((p) => ({
    slug: p.slug.split('/')[0],
    title: p.data.title,
    tags: p.data.tags,
    date: p.data.date,
    readingTime: Math.max(
      1,
      Math.ceil((p.body ?? '').split(/\s+/).filter(Boolean).length / 200)
    )
  }))
---

<BlogPostLayout
  title={title}
  seoTitle={seoTitle}
  ogImage={ogImage.src}
  ogImageWidth={ogImage.attributes.width}
  ogImageHeight={ogImage.attributes.height}
  shortDescription={shortDescription}
  author={author}
  date={date}
  tags={tags}
  lang={lang!}
  readingTime={readingTime}
  cover={cover}
  prevPost={prevPost}
  nextPost={nextPost}
  morePosts={morePosts}
  headings={headings}
>
  <Content />
</BlogPostLayout>
