---
import '@fontsource-variable/bricolage-grotesque'
import '@fontsource-variable/dm-sans'
import '@fontsource-variable/jetbrains-mono'
import bricolageUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url'
import dmSansUrl from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url'
import '../styles/global.css'
import { getLangFromUrl, useTranslation } from 'src/i18n/utils'
import { ClientRouter } from 'astro:transitions'

const lang = getLangFromUrl(Astro.url)
const t = useTranslation(lang)

interface Props {
  title?: string
  description?: string
  ogImage?: string
  ogImageWidth?: number
  ogImageHeight?: number
  ogType?: 'website' | 'article'
  publishedTime?: Date
  tags?: string[]
}

const tSeo = t('seo')
const {
  title,
  description,
  ogImage: ogImageProp,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',
  publishedTime,
  tags = []
} = Astro.props

const pageTitle = title ?? tSeo.title
const pageDescription = description ?? tSeo.description
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US'
const canonicalUrl = new URL(Astro.url.pathname, Astro.url)
const ogImage = ogImageProp
  ? new URL(ogImageProp, Astro.url)
  : new URL('/img/seo/og-image.png', Astro.url)
const twitterImage = ogImageProp
  ? new URL(ogImageProp, Astro.url)
  : new URL('/img/seo/twitter-image.png', Astro.url)
---

<html lang={lang} data-theme="dark">
  <head>
    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem('portfolio-theme')
        if (stored) document.documentElement.setAttribute('data-theme', stored)
        const accent = localStorage.getItem('portfolio-accent')
        if (accent && accent !== 'yellow')
          document.documentElement.setAttribute('data-accent', accent)
      }
      applyTheme()
      document.addEventListener('astro:after-swap', applyTheme)
      window.addEventListener('accent:set', (e) => {
        const accent = String(e.detail || 'yellow')
        if (accent === 'yellow')
          document.documentElement.removeAttribute('data-accent')
        else document.documentElement.setAttribute('data-accent', accent)
        localStorage.setItem('portfolio-accent', accent)
      })
    </script>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:type" content={ogType} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Lee Palacios" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@vitualizz" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={twitterImage} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={bricolageUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={dmSansUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="cosmos"></div>
    <div class="stars"></div>
    <div class="stars2"></div>
    <div class="stars3"></div>
    <div class="relative z-[1]">
      <slot />
    </div>
    <script>
      const reduced = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches

      function spawn(cls: string, inner: string, delay?: string) {
        const el = document.createElement('div')
        el.className = cls
        el.setAttribute('aria-hidden', 'true')
        el.innerHTML = inner
        document.body.appendChild(el)
        if (delay) el.style.animationDelay = delay
        return el
      }

      function makeClickable(cat: HTMLElement) {
        cat.style.pointerEvents = 'auto'
        cat.setAttribute('role', 'button')
        cat.setAttribute('aria-label', 'miau')
        cat.addEventListener('click', () => {
          if (cat.classList.contains('is-meowing')) return
          cat.classList.add('is-meowing')
          const bubble = document.createElement('span')
          bubble.className = 'cat-bubble'
          bubble.textContent = Math.random() < 0.5 ? 'miau' : 'prrr'
          cat.appendChild(bubble)
          window.setTimeout(() => {
            bubble.remove()
            cat.classList.remove('is-meowing')
          }, 1400)
        })
      }

      function stampede() {
        if (reduced()) return
        const emojis = ['🐈', '🐈‍⬛', '🐈', '🐈‍⬛', '🐈']
        emojis.forEach((e, i) => {
          const el = spawn(
            'walking-cat walking-cat--guest',
            `<span class="cat-emoji">${e}</span>`
          )
          el.style.bottom = `${18 + i * 26}px`
          el.style.animationDuration = `${9 + i * 1.3}s`
          el.style.animationDelay = `${i * 0.35}s`
          window.setTimeout(() => el.remove(), 12000 + i * 1300)
        })
      }

      function spawnCats() {
        if (document.querySelector('.walking-cat')) return
        if (reduced()) return
        makeClickable(spawn('walking-cat', '<span class="cat-emoji">🐈</span>'))
        spawn('peeking-cat', '🐱', '-6s')
      }

      let typed = ''
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement | null
        if (
          t &&
          (t.tagName === 'INPUT' ||
            t.tagName === 'TEXTAREA' ||
            t.isContentEditable)
        )
          return
        if (e.key.length !== 1) return
        typed = (typed + e.key.toLowerCase()).slice(-4)
        if (typed === 'meow' || typed === 'miau') {
          typed = ''
          stampede()
        }
      })
      window.addEventListener('cats:meow', stampede)

      spawnCats()
      document.addEventListener('astro:after-swap', spawnCats)
    </script>
  </body>
</html>
