---
import { getLangFromUrl } from 'src/i18n/utils'
import { useTranslation } from 'src/i18n/utils'
import experienceData from 'src/data/experience.json'
import { safeI18nHtml } from 'src/components/shared/i18nRichText'

const lang = getLangFromUrl(Astro.url)
const t = useTranslation(lang)

const MONTHS_ES = [
  'Ene',
  'Feb',
  'Mar',
  'Abr',
  'May',
  'Jun',
  'Jul',
  'Ago',
  'Sep',
  'Oct',
  'Nov',
  'Dic'
]
const MONTHS_EN = [
  'Jan',
  'Feb',
  'Mar',
  'Apr',
  'May',
  'Jun',
  'Jul',
  'Aug',
  'Sep',
  'Oct',
  'Nov',
  'Dec'
]

function formatPeriod(dateStr: string): string {
  const [year, month] = dateStr.split('-')
  const months = lang === 'es' ? MONTHS_ES : MONTHS_EN
  return `${months[parseInt(month) - 1]} ${year}`
}
---

<section class="s" id="xp">
  <div class="wrap">
    <div class="xp-head reveal">
      <h2 class="s-title">{t('home').xp_title}</h2>
      <p class="s-sub">{t('home').xp_subtitle}</p>
    </div>

    <ol class="xp-list">
      {
        experienceData.map((entry, i) => (
          <li class="xp-row">
            <div class="xp-when">
              <span>{formatPeriod(entry.period.start)}</span>
              <span class="xp-sep" aria-hidden="true" />
              {entry.period.end === null ? (
                <span class="text-accent">
                  {lang === 'es' ? 'Actualidad' : 'Present'}
                </span>
              ) : (
                <span>{formatPeriod(entry.period.end)}</span>
              )}
            </div>
            <div class="xp-main">
              <h3 class="xp-company">
                {entry.company}
                {i === experienceData.length - 1 && (
                  <span class="xp-paused">{t('home').paused_label}</span>
                )}
              </h3>
              <div class="xp-role text-coral">{entry.role}</div>
              <p
                class="xp-desc text-ink-soft"
                set:html={safeI18nHtml(
                  lang === 'es' ? entry.description_es : entry.description_en
                )}
              />
              <div class="xp-tech text-muted-custom">
                {entry.tech.map((tech) => (
                  <span>{tech}</span>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .xp-head {
    max-width: 880px;
    margin: 0 auto clamp(28px, 4vw, 44px);
  }
  .xp-head .s-title {
    text-align: left;
  }
  .xp-head .s-sub {
    margin: 0;
  }
  .xp-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 880px;
    border-top: 1px solid var(--line);
  }
  .xp-row {
    display: grid;
    grid-template-columns: 168px 1fr;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .xp-when {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .xp-sep {
    width: 18px;
    height: 1px;
    background: var(--line);
    margin: 4px 0;
  }
  .xp-company {
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
  }
  .xp-paused {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0;
  }
  .xp-role {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 10px;
  }
  .xp-desc {
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.65;
    margin: 0 0 14px;
  }
  .xp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 13px;
  }
  @media (max-width: 640px) {
    .xp-row {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 22px 0;
    }
    .xp-when {
      flex-direction: row;
      align-items: center;
      gap: 8px;
      padding-top: 0;
    }
    .xp-sep {
      margin: 0;
    }
  }
</style>
