---
import { useTranslation } from 'src/i18n/utils'
import { safeI18nHtml } from 'src/components/shared/i18nRichText'
import StackExplorer from 'src/components/StackExplorer.astro'

interface Props {
  lang: 'es' | 'en'
}
const { lang } = Astro.props
const t = useTranslation(lang)
const bioParagraphs = t('about_me').biography
const SCROLL_COMMANDS = [
  undefined,
  'cat projects.txt',
  'cd ai',
  'cat motto.txt'
]
---

<section class="s" id="about">
  <div class="wrap">
    <div class="about-grid">
      <div class="reveal">
        <h2 class="about-title">{t('home').about_title}</h2>
        <p class="about-lead text-muted-custom">{t('home').about_subtitle}</p>

        <div
          class="about-body text-ink-soft text-[clamp(16px,1.25vw,18px)] leading-[1.75]"
        >
          {
            bioParagraphs.map((p, i) => (
              <p
                data-term-cmd={SCROLL_COMMANDS[i]}
                set:html={safeI18nHtml(p)}
              />
            ))
          }
          <p
            class="about-mini text-muted-custom border-line mt-[1.6em] flex items-center gap-2 border-t border-dashed pt-[1.1em] text-[14px]"
          >
            <span
              class="cat-emoji inline-block origin-bottom"
              aria-hidden="true">🐱</span
            >
            {t('about_me').mini_note}
          </p>
        </div>
      </div>

      <div class="reveal about-aside">
        <StackExplorer lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .about-title {
    font-size: clamp(34px, 4vw, 52px);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 12px;
  }
  .about-lead {
    font-size: 17px;
    line-height: 1.55;
    max-width: 44ch;
    margin: 0 0 28px;
    text-wrap: pretty;
  }
  .about-body p + p {
    margin-top: 1.1em;
  }
  .about-aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  .cat-emoji {
    animation: catBob 3s ease-in-out infinite;
  }
  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-aside {
      position: static;
    }
  }
</style>

<script>
  import { loadMotion, whenIdle } from 'src/scripts/motion'

  function initAboutScrollytelling() {
    const paragraphs = Array.from(
      document.querySelectorAll<HTMLElement>('#about [data-term-cmd]')
    ).filter((p) => p.dataset.termCmd)
    if (!paragraphs.length) return
    if (!window.matchMedia('(min-width: 821px)').matches) return
    whenIdle(async () => {
      const motion = await loadMotion()
      if (!motion) return
      paragraphs.forEach((p) =>
        motion.ScrollTrigger.create({
          trigger: p,
          start: 'top 55%',
          once: true,
          onEnter: () =>
            window.dispatchEvent(
              new CustomEvent('terminal:run', {
                detail: { command: p.dataset.termCmd }
              })
            )
        })
      )
    })
  }
  initAboutScrollytelling()
  document.addEventListener('astro:page-load', initAboutScrollytelling)
</script>
