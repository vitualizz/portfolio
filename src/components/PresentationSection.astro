---
import { useTranslation } from 'src/i18n/utils'
import ResumeActions from 'src/components/ResumeActions.astro'
import { safeI18nHtml } from 'src/components/shared/i18nRichText'

interface Props {
  lang: 'es' | 'en'
}
const { lang } = Astro.props
const t = useTranslation(lang)
const tp = t('presentation')
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <p
          class="hero-greet text-ink-soft mb-3 font-sans font-medium"
          style="font-size:clamp(20px,2vw,26px)"
        >
          {tp.hi}
        </p>

        <h1
          class="mb-6 leading-[1.04] font-extrabold tracking-[-0.035em]"
          style="font-size:clamp(44px,6vw,88px)"
        >
          <Fragment set:html={safeI18nHtml(tp.i_am)} />
        </h1>

        <p
          class="profession text-ink mb-5 font-medium"
          style="font-size:clamp(18px,1.6vw,22px)"
        >
          {tp.profession}
        </p>

        <p
          class="description mb-5 max-w-[48ch] leading-[1.7] text-[color:var(--muted)]"
          style="font-size:clamp(15px,1.2vw,17px)"
        >
          <Fragment set:html={safeI18nHtml(tp.description)} />
        </p>

        <p
          class="description-ps text-muted-custom mb-9 max-w-[46ch] pl-[14px] text-[13.5px] leading-[1.55] italic"
        >
          {tp.description_ps}
        </p>

        <form class="hero-ask" data-hero-ask aria-label={tp.ask_label}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hero-ask-icon"
            aria-hidden="true"
            ><path
              d="M12 2 L13.5 8.5 L20 10 L13.5 11.5 L12 18 L10.5 11.5 L4 10 L10.5 8.5 Z"
            ></path></svg
          >
          <input
            class="hero-ask-input"
            type="text"
            maxlength="280"
            autocomplete="off"
            placeholder={tp.ask_placeholder}
            aria-label={tp.ask_label}
          />
          <button class="hero-ask-btn" type="submit">{tp.ask_submit}</button>
        </form>
        <div class="hero-ask-hints">
          <button
            type="button"
            class="hero-hint"
            data-hero-hint={t('ai').tabs.backend}
          >
            {t('ai').tab_labels.backend}
          </button>
          <button
            type="button"
            class="hero-hint"
            data-hero-hint={t('ai').tabs.ai_builder}
          >
            {t('ai').tab_labels.ai_builder}
          </button>
          <button
            type="button"
            class="hero-hint"
            data-hero-hint={t('ai').tabs.culture}
          >
            {t('ai').tab_labels.culture}
          </button>
        </div>

        <div class="hero-actions flex flex-wrap items-center gap-[10px]">
          <ResumeActions
            lang={lang}
            variant="hero"
            triggerId="resume-actions-hero"
          />
          <button
            class="icon-btn bg-bg-2 border-line text-ink hover:bg-accent hover:border-accent inline-flex h-12 w-12 cursor-pointer items-center justify-center rounded-[var(--r-md)] border transition-[transform,background,border-color,color] duration-200 hover:-translate-y-0.5 hover:text-[#0b0c10]"
            data-open-modal="contact"
            aria-label={lang === 'es'
              ? 'Abrir formulario de contacto'
              : 'Open contact form'}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-[22px] w-[22px]"
              aria-hidden="true"
              ><rect x="3" y="5" width="18" height="14" rx="2"></rect><polyline
                points="3,7 12,13 21,7"></polyline></svg
            >
          </button>
          <a
            class="icon-btn bg-bg-2 border-line text-ink hover:bg-accent hover:border-accent inline-flex h-12 w-12 cursor-pointer items-center justify-center rounded-[var(--r-md)] border transition-[transform,background,border-color,color] duration-200 hover:-translate-y-0.5 hover:text-[#0b0c10]"
            href="https://github.com/vitualizz"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-[22px] w-[22px]"
              aria-hidden="true"
              ><path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2.1c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.23 2.76.12 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.12v3.14c0 .31.21.66.79.55A11.51 11.51 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5z"
              ></path></svg
            >
          </a>
          <a
            class="icon-btn linkedin inline-flex h-12 w-12 cursor-pointer items-center justify-center rounded-[var(--r-md)] transition-[transform,background,border-color,color] duration-200 hover:-translate-y-0.5"
            href="https://linkedin.com/in/vitualizz"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-[22px] w-[22px]"
              aria-hidden="true"
              ><path
                d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <div class="hero-figure relative" data-hero-3d>
        <span class="blob-tag">{tp.online_tag}</span>
        <img
          class="hero-character relative z-[1] h-full w-full object-contain object-bottom"
          src="/img/Logo2.webp"
          alt={lang === 'es'
            ? 'Ilustración de Lee Palacios con sus tres gatos'
            : 'Illustration of Lee Palacios with his three cats'}
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - var(--header-h));
    display: flex;
    align-items: center;
    padding: clamp(40px, 6vw, 80px) 0 clamp(48px, 8vw, 96px);
    position: relative;
  }
  .hero > .wrap {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    width: 100%;
  }

  .description-ps {
    border-left: 2px dashed color-mix(in oklab, var(--coral) 50%, var(--line));
  }

  .hero-ask {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 560px;
    padding: 6px 6px 6px 14px;
    background: color-mix(in oklab, var(--bg-2) 85%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .hero-ask:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
  }
  .hero-ask-icon {
    width: 18px;
    height: 18px;
    color: var(--accent);
    flex-shrink: 0;
  }
  .hero-ask-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    padding: 8px 0;
  }
  .hero-ask-input::placeholder {
    color: var(--muted);
  }
  .hero-ask-btn {
    flex-shrink: 0;
    height: 40px;
    padding: 0 16px;
    border: none;
    border-radius: 999px;
    background: var(--accent);
    color: #0b0c10;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .hero-ask-btn:hover {
    background: var(--coral);
    color: #fff;
  }
  .hero-ask-hints {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 10px 0 28px 4px;
  }
  .hero-hint {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    border-radius: 999px;
    padding: 5px 11px;
    font: inherit;
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .hero-hint:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .linkedin {
    background: #0a66c2;
    color: #fff;
    border: 1px solid transparent;
  }
  .linkedin:hover {
    background: #0d7dd6;
  }

  .hero-figure {
    aspect-ratio: 1 / 1;
    max-width: 540px;
    width: 100%;
    margin-left: auto;
  }
  .hero-figure::before {
    content: '';
    position: absolute;
    inset: 8% 4% 4% 4%;
    background: radial-gradient(
      circle at 50% 55%,
      color-mix(in oklab, var(--accent) 22%, transparent) 0%,
      transparent 65%
    );
    filter: blur(20px);
    z-index: 0;
    transition: opacity 0.8s ease;
  }
  .hero-figure.is-3d::before {
    inset: 10% 6% 12% 6%;
    background: var(--accent);
    border-radius: 56% 44% 40% 60% / 60% 50% 50% 40%;
    filter: none;
    animation: morph 12s ease-in-out infinite;
  }
  .hero-figure.is-3d::after {
    content: '';
    position: absolute;
    left: 24%;
    right: 30%;
    bottom: 8.5%;
    height: 5%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 0, 0, 0.45),
      rgba(0, 0, 0, 0) 70%
    );
    z-index: 1;
    pointer-events: none;
  }
  .hero-character {
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.45));
    animation: floatY 8s ease-in-out infinite;
    transition: opacity 0.6s ease;
  }
  .hero-figure.is-3d .hero-character {
    opacity: 0;
    pointer-events: none;
  }
  .hero-figure.is-3d {
    cursor: pointer;
  }
  .hero-figure :global(.hero-3d-canvas) {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100% !important;
    height: 100% !important;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .hero-figure.is-3d :global(.hero-3d-canvas) {
    opacity: 1;
  }

  .blob-tag {
    position: absolute;
    top: 14%;
    right: 8%;
    z-index: 2;
    transform: rotate(6deg);
    background: var(--bg);
    color: var(--ink);
    border: 1px solid var(--line);
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }
  .blob-tag::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mint);
    margin-right: 8px;
    vertical-align: middle;
    position: relative;
    top: -1px;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--mint) 25%, transparent);
  }

  @media (max-width: 540px) {
    .hero-ask-btn {
      padding: 0 12px;
    }
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-figure {
      max-width: 320px;
      margin: 0 auto;
      order: -1;
    }
    .blob-tag {
      top: 2%;
      right: 0;
    }
    .hero-character {
      filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.35));
    }
    .hero {
      min-height: auto;
      padding-top: 28px;
    }
  }
</style>

<script>
  function initHeroAsk() {
    const form = document.querySelector<HTMLFormElement>('[data-hero-ask]')
    if (!form || form.dataset.ready === 'true') return
    form.dataset.ready = 'true'
    const input = form.querySelector<HTMLInputElement>('.hero-ask-input')

    const send = (question: string) => {
      const q = question.trim()
      if (!q) return
      window.dispatchEvent(
        new CustomEvent('ask-lee:ask', { detail: { question: q } })
      )
      document.getElementById('ai')?.scrollIntoView({ behavior: 'smooth' })
      if (input) input.value = ''
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault()
      send(input?.value ?? '')
    })
    document
      .querySelectorAll<HTMLButtonElement>('[data-hero-hint]')
      .forEach((b) =>
        b.addEventListener('click', () => send(b.dataset.heroHint ?? ''))
      )
  }
  initHeroAsk()
  document.addEventListener('astro:page-load', initHeroAsk)
</script>

<script>
  import { whenIdle } from 'src/scripts/motion'

  type NetInfo = { saveData?: boolean; effectiveType?: string }

  function connectionAllows3D() {
    const net = (navigator as Navigator & { connection?: NetInfo }).connection
    if (!net) return true
    if (net.saveData) return false
    return !/(^|-)2g$|^3g$/.test(net.effectiveType ?? '')
  }

  function canRender3D() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
      return false
    if (!connectionAllows3D()) return false
    const probe = document.createElement('canvas')
    return !!(probe.getContext('webgl2') || probe.getContext('webgl'))
  }

  function initHero3D() {
    const host = document.querySelector<HTMLElement>('[data-hero-3d]')
    if (!host || host.dataset.mounted === 'true' || !canRender3D()) return
    host.dataset.mounted = 'true'
    whenIdle(async () => {
      const { mountHeroCharacter } = await import('src/scripts/heroCharacter')
      const handle = await mountHeroCharacter(host, () =>
        host.classList.add('is-3d')
      ).catch(() => null)
      if (!handle) {
        host.dataset.mounted = 'false'
        return
      }
      document.addEventListener('astro:before-swap', () => handle.dispose(), {
        once: true
      })
    })
  }
  initHero3D()
  document.addEventListener('astro:page-load', initHero3D)
</script>
